# Pass --env-file .env explicitly; process environment values take precedence.
FRONT_DOOR_RTSP_URL=rtsp://replace-me:replace-me@camera.example.invalid/stream
HOMESIGHT_MODEL_API_KEY=replace-me
HOMESIGHT_QDRANT_API_KEY=replace-me
# Host-side clients and the local Qdrant test container share these settings.
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=segments

# The tutorial uses your existing camera and S3 storage.
TEST_RTSP_URL=rtsp://replace-me:replace-me@camera.example.invalid/stream
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=replace-me
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_SESSION_TOKEN=
# This endpoint must already serve a multimodal embedding model.
HOMESIGHT_MODEL_BASE_URL=http://localhost:8000/v1
HOMESIGHT_MODEL_NAME=replace-with-served-multimodal-model
HOMESIGHT_EMBEDDING_DIMENSION=1024
