name: "segment_embedding"
backend: "python"
max_batch_size: 0
input [
  { name: "VIDEO", data_type: TYPE_UINT8, dims: [-1, 2, 8, 8, 3], optional: true },
  { name: "TEXT", data_type: TYPE_STRING, dims: [-1, 1], optional: true }
]
output [{ name: "EMBEDDING", data_type: TYPE_FP32, dims: [-1, 16] }]
instance_group [{ kind: KIND_CPU }]
